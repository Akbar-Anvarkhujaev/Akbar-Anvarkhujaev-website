---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getProjects } from "../../lib/projects";
import { hasWriteup } from "../../lib/rich";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .filter((p) => hasWriteup(p.body))
    .map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
---

<Base title={d.title} description={d.summary}>
  <article class="prose">
    <a class="back" href="/projects">← All projects</a>
    <h1>{d.title}</h1>
    {d.subtitle && <p class="subtitle">{d.subtitle}</p>}
    <div class="writeup-meta">
      {d.tags.length > 0 && <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>}
      <div class="card-links">
        {d.repo && <a href={d.repo} target="_blank" rel="noopener">Code on GitHub →</a>}
        {d.demo && <a href={d.demo} target="_blank" rel="noopener">Live demo →</a>}
      </div>
    </div>
    <Content />
  </article>
</Base>
